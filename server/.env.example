# Copy this file to .env and fill in real values. Never commit .env itself.

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/client_insights_dashboard

# Any long, random string — used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
